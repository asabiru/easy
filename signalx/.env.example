# SignalX MVP v0.1 — environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
POSTGRES_USER=signalx
POSTGRES_PASSWORD=signalx
POSTGRES_DB=signalx
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://signalx:signalx@db:5432/signalx

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Exchange (ccxt) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_USE_MOCK=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# IMPORTANT: MVP v0.1 must NOT execute live trades.
ENABLE_AUTOTRADE=false

# ────────────────────────── Custody / managed pool (Mode B) ────────────── #
# When True, /wallet/deposit-address surfaces a real address and accepts
# production-mode webhooks. Default OFF so a misconfigured deploy can't
# accidentally take real client money. NEVER flip this on in any deploy
# without legal sign-off in the operating jurisdiction.
CUSTODY_LIVE_DEPOSITS_ENABLED=false
# Free-text licence attestation surfaced in /legal/disclosures and checked
# at every deposit. Empty = MVP / pre-licence; the deposit endpoint then
# refuses with 503 unless CUSTODY_SELF_ATTEST_OVERRIDE=true.
CUSTODY_LICENSE_JURISDICTION=
CUSTODY_LICENSE_NUMBER=
# Operator opt-in to accept liability without a licence. Use only if you
# understand the legal posture in your jurisdiction. Required because
# without this OR a licence, /wallet/deposit-address refuses with 503.
CUSTODY_SELF_ATTEST_OVERRIDE=false
# Performance fee % of gains above per-client high-water mark. Default 20%.
CUSTODY_PERF_FEE_PCT=0.20
# Management fee % of equity per year, daily-pro-rata. Default 2%.
CUSTODY_MGMT_FEE_PCT_ANNUAL=0.02
# 24h post-deposit cooldown to prevent flush-attacks (deposit → withdraw
# round-trip).
CUSTODY_WITHDRAW_COOLDOWN_HOURS=24
# Minimum USDT amount per withdrawal (under this rejected with 400).
CUSTODY_MIN_WITHDRAW_USDT=10.0

# Hourly Celery beat task that snapshots NAV + accrues perf fees.
# Default OFF — operator still calls /admin/treasury/nav/snapshot manually.
# When flipped to true, the task reads AUM from CUSTODY_NAV_AUTOSCHEDULE_AUM_USDT.
# Future: replaced by a real exchange + on-chain balance adapter.
CUSTODY_NAV_AUTOSCHEDULE_ENABLED=false
# Stub AUM source for the autoscheduler. Unset → task no-ops.
# CUSTODY_NAV_AUTOSCHEDULE_AUM_USDT=

# ─────────────────── Chain webhook secrets (managed pool) ───────────── #
# Each chain's deposit webhook is gated on:
#   (a) CUSTODY_LIVE_DEPOSITS_ENABLED=true (master toggle), AND
#   (b) the chain-specific secret below being non-empty.
# Empty secret = that chain's webhook returns 503 even if (a) is on.
# This forces an explicit per-chain operator decision to go live.
# Rotate immediately on any suspicion of leak — leak = unauthenticated
# deposit credit (signature-only auth, no wallet-side balance check).
CUSTODY_TRONGRID_WEBHOOK_SECRET=
CUSTODY_ALCHEMY_WEBHOOK_SECRET=
CUSTODY_HELIUS_WEBHOOK_SECRET=
CUSTODY_BSCSCAN_WEBHOOK_SECRET=
# TON Wallet Pay webhook secret is reused from the existing subscription
# config (TON_WALLET_PAY_WEBHOOK_SECRET above) for the managed-pool path.
