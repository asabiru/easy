# SignalX MVP v0.1 — environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ---
POSTGRES_USER=signalx
POSTGRES_PASSWORD=signalx
POSTGRES_DB=signalx
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://signalx:signalx@db:5432/signalx

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- Exchange (ccxt) ---
EXCHANGE_ID=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_USE_MOCK=true

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# IMPORTANT: MVP v0.1 must NOT execute live trades.
ENABLE_AUTOTRADE=false
